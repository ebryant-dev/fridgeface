{
  "name": "fridgeface",
  "version": "0.5.2",
  "license": "UNLICENSED",
  "description": "Fridgeface: an interactive five-shape type toy, shipped as the <fridge-face> web component.",
  "type": "module",
  "main": "./dist/fridgeface.js",
  "module": "./dist/fridgeface.js",
  "exports": {
    ".": {
      "import": "./dist/fridgeface.js",
      "default": "./dist/fridgeface.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:browsers": "playwright test",
    "build": "tsc --noEmit && vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "preview": "vite preview",
    "preview:site": "vite preview --config vite.site.config.ts",
    "prepare": "vite build"
  },
  "devDependencies": {
    "@fontsource/jost": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "sideEffects": true
}
